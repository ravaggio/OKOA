<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
    xmlns:animations="clr-namespace:Rg.Plugins.Popup.Animations;assembly=Rg.Plugins.Popup"
    x:Class="ctf_final.PopupPages.AddSchedulePopup">
    <!--You can set an animation in the xaml file or in the csharp code behind-->
    <pages:PopupPage.Animation>
        <animations:ScaleAnimation 
            PositionIn="Center"
            PositionOut="Center"
            ScaleIn="1.2"
            ScaleOut="0.8"
            DurationIn="50"
            DurationOut="50"
            EasingIn="SinOut"
            EasingOut="SinIn"
            HasBackgroundAnimation="True"/>
    </pages:PopupPage.Animation>
    <!--You can use any elements here which are extended from Xamarin.Forms.View-->
    <Grid ColumnSpacing="0" RowSpacing="6" BackgroundColor="#FF090909" VerticalOptions="Center" HorizontalOptions="Fill" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" Text="ADICIONAR HORÁRIO" Margin="0, 10, 0, 0" FontSize="Large" TextColor="{StaticResource Orange}" Grid.ColumnSpan="2"/>
        <TimePicker x:Name="timePicker" Format="HH:mm" Grid.Row="1" TextColor="{StaticResource Orange}" Margin="10, 10, 0, 0" >
            <TimePicker.BackgroundColor>
                <OnPlatform x:TypeArguments="Color">
                    <OnPlatform.Platforms>
                        <On Platform="iOS" Value="{StaticResource PrimaryDark}" />
                        <On Platform="Android" Value="Transparent" />
                    </OnPlatform.Platforms>
                </OnPlatform>
            </TimePicker.BackgroundColor>
        </TimePicker>
        <Picker x:Name="typePicker" Grid.Row="1" Grid.Column="1" TextColor="{StaticResource Orange}" SelectedItem="Treino" Margin="0, 10, 10, 0">
            <Picker.Items>
                <x:String>Treino</x:String>
                <x:String>Yoga</x:String>
                <x:String>Pilates</x:String>
            </Picker.Items>
            <Picker.BackgroundColor>
                <OnPlatform x:TypeArguments="Color">
                    <OnPlatform.Platforms>
                        <On Platform="iOS" Value="{StaticResource PrimaryDark}" />
                        <On Platform="Android" Value="Transparent" />
                    </OnPlatform.Platforms>
                </OnPlatform>
            </Picker.BackgroundColor>
        </Picker>
        <Grid Grid.Row="2" Grid.ColumnSpan="2" x:Name="weekdaysGrid" ColumnSpacing="1" Margin="16, 10" Padding="1" BackgroundColor="{StaticResource Primary}">
            <BoxView ClassId="0" Grid.Column="0" BackgroundColor="{StaticResource DarkTransparent}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="AddOrRemoveWeekday" NumberOfTapsRequired="1" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Label Text="D" Grid.Column="0" TextColor="{StaticResource TextLight}" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
            <BoxView ClassId="1" Grid.Column="1" BackgroundColor="{StaticResource DarkTransparent}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="AddOrRemoveWeekday" NumberOfTapsRequired="1" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Label Text="S" Grid.Column="1" TextColor="{StaticResource TextLight}" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
            <BoxView ClassId="2" Grid.Column="2" BackgroundColor="{StaticResource DarkTransparent}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="AddOrRemoveWeekday" NumberOfTapsRequired="1" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Label Text="T" Grid.Column="2" TextColor="{StaticResource TextLight}" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
            <BoxView ClassId="3" Grid.Column="3" BackgroundColor="{StaticResource DarkTransparent}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="AddOrRemoveWeekday" NumberOfTapsRequired="1" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Label Text="Q" Grid.Column="3" TextColor="{StaticResource TextLight}" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
            <BoxView ClassId="4" Grid.Column="4" BackgroundColor="{StaticResource DarkTransparent}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="AddOrRemoveWeekday" NumberOfTapsRequired="1" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Label Text="Q" Grid.Column="4" TextColor="{StaticResource TextLight}" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
            <BoxView ClassId="5" Grid.Column="5" BackgroundColor="{StaticResource DarkTransparent}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="AddOrRemoveWeekday" NumberOfTapsRequired="1" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Label Text="S" Grid.Column="5" TextColor="{StaticResource TextLight}" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
            <BoxView ClassId="6" Grid.Column="6" BackgroundColor="{StaticResource DarkTransparent}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="AddOrRemoveWeekday" NumberOfTapsRequired="1" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Label Text="S" Grid.Column="6" TextColor="{StaticResource TextLight}" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
        </Grid>
        <BoxView Grid.Row="3" BackgroundColor="{StaticResource Red}" />
        <Button Grid.Row="3" BackgroundColor="Transparent" TextColor="Black" Text="CANCELAR" Clicked="CancelButton" />
        <BoxView Grid.Row="3"  Grid.Column="1" BackgroundColor="{StaticResource Orange}" />
        <Button Grid.Row="3" Grid.Column="1"  Text="ADICIONAR" TextColor="Black" BackgroundColor="Transparent" Clicked="AddButon" />
    </Grid>
</pages:PopupPage>